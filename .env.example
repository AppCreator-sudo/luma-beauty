PORT=3100
APP_ORIGIN=https://atelie-13-143-66-1.sslip.io
DATA_DIR=/opt/atelie/shared
NODE_ENV=production
# Optional: create a Yandex ID app with callback APP_ORIGIN/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID confidential Web application: enable confidential mode and allow server
# egress IP in application settings. Copy the service access key, server-only.
# Callback: APP_ORIGIN/auth/vk/callback
VK_CLIENT_ID=
VK_SERVICE_TOKEN=
# Telegram Login OIDC credentials from BotFather > Login Widget, NOT bot token.
# Allowed URLs: APP_ORIGIN and APP_ORIGIN/auth/telegram/callback
# Keep signing algorithm RS256 (default). Secrets are server-only.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Optional HTTPS geocoder endpoint; defaults to the public Nominatim pilot service.
GEOCODER_URL=
# DaData suggestions API key, server-only. Secret key is not required.
DADATA_API_KEY=
# Shared daily outbound budget (leave headroom below the provider's free quota).
ADDRESS_DAILY_LIMIT=9000
# Server-controlled pilot placements; disabled until configured and reviewed.
PROMOTIONS_ENABLED=0
# Operator name for the local/server administration command, not a browser key.
PROMOTION_OPERATOR=
